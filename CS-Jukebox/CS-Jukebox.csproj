<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>CS_Jukebox</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>CS_Jukebox.Program</StartupObject>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    
    <!-- Version management to match GitHub Release tags -->
    <Version>1.3.3</Version>
    <AssemblyVersion>1.3.3.0</AssemblyVersion>
    <FileVersion>1.3.3.0</FileVersion>

    <!-- Publish as self-contained single executable -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSelfContained>true</PublishSelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    
    <!-- Avoid aggressive trimming for compatibility with dynamic serialization and audio codecs -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="NAudio" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSGSI\CSGSI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="gamestate_integration_jukebox.cfg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="gamestate_integration_jukebox.cfg" LogicalName="CS_Jukebox.gamestate_integration_jukebox.cfg" />
  </ItemGroup>

</Project>