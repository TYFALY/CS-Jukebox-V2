<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>CS_Jukebox</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>CS_Jukebox.Program</StartupObject>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <!-- Publish as self-contained by default to avoid requiring pre-installed runtime on target machines -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSelfContained>true</PublishSelfContained>
    <!-- Avoid aggressive trimming for compatibility with dynamic serialization and audio codecs -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="NAudio" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSGSI\CSGSI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="gamestate_integration_jukebox.cfg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
